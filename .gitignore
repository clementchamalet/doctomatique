# ========================================
# .gitignore for Doctomatique
# ========================================

# ===== LOCAL DATA =====
assets/messages/*
!assets/messages/.gitkeep

# ===== LOCAL CONFIGURATION =====
php.ini
config.local.php
.env
.env.local

# ===== SYSTEM FOLDERS =====
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== EDITORS =====
# VSCode
.vscode/
*.code-workspace

# PhpStorm / IntelliJ
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ===== LOGS AND DATABASES =====
*.log
*.sql.gz
*.sqlite
*.sqlite3

# ===== TEMPORARY FILES =====
*.tmp
*.temp
*.bak
*.swp
*~

# ===== TOOLS =====
vendor/
node_modules/
